{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "YOUR_KEY",
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_MODEL": "deepseek-v4-pro[1m]",
    "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-v4-flash",
    "API_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read(//C/Users/kit91/WebstormProjects/recursionAi/**)",
      "Edit(//C/Users/kit91/WebstormProjects/recursionAi/**)",
      "Write(//C/Users/kit91/WebstormProjects/recursionAi/**)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(ng:*)",
      "Bash(git:*)",
      "Bash(openapi-generator-cli:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Read(//C/Users/kit91/WebstormProjects/recursionAi/.env)",
      "Read(//C/Users/kit91/WebstormProjects/recursionAi/.env.*)"
    ]
  }
}
